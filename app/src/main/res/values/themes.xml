<resources>
    <style name="Theme.VoidLauncher" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/theme_background</item>
        <item name="android:colorAccent">@color/theme_accent</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.VoidLauncher.Splash" parent="Theme.VoidLauncher" />
</resources>
